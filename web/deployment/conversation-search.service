# Systemd service file for Conversation Search Flask application
#
# INSTALLATION INSTRUCTIONS:
# -------------------------
# 1. Edit this file and replace the following placeholders:
#    - USER: Your username (default: $USER)
#    - GROUP: Your group name (default: $USER)
#    - /path/to/json-lite: Full path to json-lite repository
#    - /path/to/venv: Full path to Python virtual environment (optional if using system Python)
#
# 2. Copy the edited file to systemd directory:
#    sudo cp conversation-search.service /etc/systemd/system/
#
# 3. Create log file with proper permissions:
#    sudo touch /var/log/conversation-search.log
#    sudo chown USER:GROUP /var/log/conversation-search.log
#
# 4. Create .env file with your configuration:
#    cp /path/to/json-lite/.env.example /path/to/json-lite/.env
#    Edit .env and set DATA_DIR, DATABASE_PATH, FLASK_HOST, FLASK_PORT, API_KEY, etc.
#
# 5. Reload systemd daemon:
#    sudo systemctl daemon-reload
#
# 6. Enable service to start on boot:
#    sudo systemctl enable conversation-search.service
#
# 7. Start the service:
#    sudo systemctl start conversation-search.service
#
# 8. Check service status:
#    sudo systemctl status conversation-search.service
#
# 9. View logs:
#    sudo journalctl -u conversation-search.service -f
#    or
#    tail -f /var/log/conversation-search.log
#
# MANAGEMENT COMMANDS:
# -------------------
# Stop service:    sudo systemctl stop conversation-search.service
# Restart service: sudo systemctl restart conversation-search.service
# Disable service: sudo systemctl disable conversation-search.service
# View full logs:  sudo journalctl -u conversation-search.service

[Unit]
Description=Conversation Search Flask Application
After=network.target
Wants=network-online.target

[Service]
Type=simple
# REPLACE WITH YOUR USERNAME AND GROUP
User=USER
Group=GROUP

# REPLACE WITH YOUR PATHS
WorkingDirectory=/path/to/json-lite/web

# Use the virtual environment Python (if using venv)
# REPLACE WITH YOUR PATHS OR COMMENT OUT IF USING SYSTEM PYTHON
Environment="PATH=/path/to/venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
Environment="VIRTUAL_ENV=/path/to/venv"

# Run Flask in production mode (not debug)
Environment="FLASK_APP=app.py"
Environment="FLASK_ENV=production"

# Load environment variables from .env file
# REPLACE WITH YOUR PATH
EnvironmentFile=/path/to/json-lite/.env

# Execute Flask using the venv Python with production wrapper
# REPLACE WITH YOUR PATHS
ExecStart=/path/to/venv/bin/python /path/to/json-lite/web/deployment/app-production.py

# Restart policy
Restart=on-failure
RestartSec=10
StartLimitInterval=200
StartLimitBurst=5

# Logging
StandardOutput=append:/var/log/conversation-search.log
StandardError=append:/var/log/conversation-search.log

# Security settings
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/log

# Resource limits (optional, adjust as needed)
LimitNOFILE=1024
LimitNPROC=64

[Install]
WantedBy=multi-user.target